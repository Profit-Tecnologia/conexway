# SMTP account used to send the contact form (set these in Vercel/Netlify → Environment Variables)
# Hostinger: smtp.hostinger.com, port 465, SSL
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=customerdesk@convexway.com
SMTP_PASS=
# Optional
MAIL_TO=customerdesk@convexway.com
MAIL_FROM=customerdesk@convexway.com
